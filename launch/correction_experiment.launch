<launch>
  <!-- Experiment parameters -->
  <param name="data_path"         value="$(find dnf_correction)/data" />
  <param name="n_iterations"      value="2" />
  <param name="t_lim"             value="30.0" />
  <param name="t_feedback_lim"    value="30.0" />
  <param name="trigger_step"      value="100" />

  <!-- Single node running full experiment -->
  <node name="correction_experiment"
        pkg="dnf_correction"
        type="correction_experiment_node.py"
        output="screen" />
</launch>